generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" depending on your choice
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      UserRole @default(TEACHER)
  password  String
  createdAt DateTime @default(now())
  // relations
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId Int?
  student   Student? @relation(fields: [studentId], references: [id])
  studentId Int?
  results   Result[] @relation("TeacherResults")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model Teacher {
  id       Int     @id @default(autoincrement())
  user     User    @relation(fields: [userId], references: [id])
  userId   Int     @unique
  courses  Course[]
}

model Course {
  id    Int     @id @default(autoincrement())
  name  String
  code  String  @unique
  // optional: link to teacher
  teacherId Int?
  materials CourseMaterial[]
}

model Student {
  id           Int      @id @default(autoincrement())
  matric       String   @unique
  surname      String
  firstname    String
  othername    String?
  className    String // e.g. "Primary 4"
  createdAt    DateTime @default(now())
  results      Result[]
  attendances  Attendance[]
  userId       Int?     // if students have user accounts
  user         User?    @relation(fields:[userId], references:[id])
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique
  maxScore Int @default(100)
  results Result[]
}

model Term {
  id    Int    @id @default(autoincrement())
  name  String // "First Term"
  year  String // "2024/2025"
  @@unique([name, year])
  results Result[]
  attendances Attendance[]
}

model Result {
  id            Int      @id @default(autoincrement())
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id])
  subjectId     Int
  term          Term     @relation(fields: [termId], references: [id])
  termId        Int
  continuous    Int      // CA out of (e.g.) 30
  summary       Int      // test/exam out of (e.g.) 70
  total         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      String?
  teacherId     Int?     // who entered it
  teacher       User?    @relation("TeacherResults", fields: [teacherId], references: [id])
}

model Attendance {
  id          Int      @id @default(autoincrement())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   Int
  term        Term     @relation(fields: [termId], references: [id])
  termId      Int
  sessionsOpened Int
  timesPresent   Int
  timesAbsent    Int
  timesPunctual  Int
  createdAt   DateTime @default(now())
}

model CourseMaterial {
  id Int @id @default(autoincrement())
  courseId Int
  fileUrl String
}
